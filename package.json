{
  "name": "brasil-2030-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run build && npm test && node scripts/check-build.mjs",
    "preview": "astro preview",
    "deploy:dry": "npm run validate && wrangler deploy --dry-run",
    "deploy": "npm run validate && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.104.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "undici": "7.29.0"
  }
}
