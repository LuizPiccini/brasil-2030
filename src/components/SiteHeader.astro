---
import { routes, siteCopy, type ContentPageKey, type Locale, type PageKey } from "../data/site";

interface Props {
  locale: Locale;
  pageKey: PageKey;
  markdownHref?: string;
  candidate?: boolean;
}

const { locale, pageKey, markdownHref, candidate = false } = Astro.props;
const copy = siteCopy[locale];
const navKeys: ContentPageKey[] = candidate
  ? ["scenario", "summary", "redata", "about"]
  : ["scenario", "summary", "redata", "evidence", "strategy", "letter", "about"];
const secondaryKeys: ContentPageKey[] = candidate ? ["evidence", "strategy", "letter"] : [];
const navHref = (key: ContentPageKey) => candidate && key === "scenario" ? "/candidato" : candidate && key === "summary" ? "/candidato#resumo-do-cenario" : routes[locale][key];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={navHref("scenario")} aria-label={copy.title}>
      <span class="wordmark-country">{locale === "pt" ? "BRASIL" : "BRAZIL"}</span>
      <span class="wordmark-year">2030</span>
    </a>

    <nav class="desktop-nav" aria-label={locale === "pt" ? "Navegação principal" : "Primary navigation"}>
      {navKeys.map((key) => (
        <a href={navHref(key)} aria-current={pageKey === key ? "page" : undefined}>
          {copy.nav[key as keyof typeof copy.nav]}
        </a>
      ))}
      {locale === "pt" && !candidate && <a href="/candidato">Candidata</a>}
    </nav>

    <div class="header-tools">
      {!candidate && <a class="header-cta" href={routes[locale].support}>{copy.nav.support}</a>}
      {!candidate && <div class="language-switch" aria-label={locale === "pt" ? "Idioma" : "Language"}>
        <a href={routes.pt[pageKey]} lang="pt-BR" aria-current={locale === "pt" ? "true" : undefined}>PT</a>
        <span aria-hidden="true">/</span>
        <a href={routes.en[pageKey]} lang="en" aria-current={locale === "en" ? "true" : undefined}>EN</a>
      </div>}
      {candidate && <div class="language-switch" aria-label="Idioma">
        <a href="/candidato" lang="pt-BR" aria-current="true">PT</a><span aria-hidden="true">/</span>
        <span aria-disabled="true" title="Este texto ainda não tem tradução em inglês">EN</span>
      </div>}
      {markdownHref && <a class="format-link" href={markdownHref} aria-label={locale === "pt" ? "Ler esta página em Markdown" : "Read this page as Markdown"}>MD</a>}
      <details class="mobile-menu">
        <summary aria-label={copy.menu}><span></span><span></span><span></span></summary>
        <nav aria-label={candidate ? "Navegação completa" : locale === "pt" ? "Navegação móvel" : "Mobile navigation"}>
          {navKeys.map((key) => (
            <a href={navHref(key)} aria-current={pageKey === key ? "page" : undefined}>
              {copy.nav[key as keyof typeof copy.nav]}
            </a>
          ))}
          {secondaryKeys.map((key) => <a href={routes[locale][key]}>{copy.nav[key as keyof typeof copy.nav]}</a>)}
          {locale === "pt" && !candidate && <a href="/candidato">Versão candidata</a>}
          <a href={routes[locale].support}>{copy.nav.support}</a>
          <a href={routes[locale].signatories}>{copy.nav.signatories}</a>
          {markdownHref && <a href={markdownHref}>{locale === "pt" ? "Ler em Markdown" : "Read as Markdown"}</a>}
        </nav>
      </details>
    </div>
  </div>
</header>
