  },
  {
    kind: "scenario", labelPt: "Invenção narrativa", labelEn: "Narrative invention", confidencePt: "Não se aplica", confidenceEn: "Not applicable",
    claimPt: "No cenário negativo, Estados Unidos e China fecham um acordo de desaceleração em 2028 que preserva sua vantagem e não garante capacidade ao Brasil.",
    claimEn: "In the negative scenario, the United States and China reach a slowdown agreement in 2028 that preserves their advantage and does not guarantee capacity to Brazil.",
    source: pt ? "Cenário negativo" : "Negative scenario", url: pt ? "/#2028-o-acordo-dos-outros" : "/en#2028-someone-elses-agreement", checked: "28/08/2026",
  },
  {
    kind: "scenario", labelPt: "Invenção narrativa", labelEn: "Narrative invention", confidencePt: "Não se aplica", confidenceEn: "Not applicable",
    claimPt: "Empresas brasileiras trocam dados operacionais por ciberdefesa estrangeira após uma onda de ransomware em 2027.",
    claimEn: "Brazilian firms exchange operational data for foreign cyberdefense after a ransomware wave in 2027.",
    source: pt ? "Cenário negativo" : "Negative scenario", url: pt ? "/#2027-ataques-demissões-e-poderes-de-emergência" : "/en#2027-attacks-layoffs-and-emergency-powers", checked: "28/08/2026",
  },
  {
    kind: "scenario", labelPt: "Invenção narrativa", labelEn: "Narrative invention", confidencePt: "Não se aplica", confidenceEn: "Not applicable",
    claimPt: "No cenário negativo, o Brasil aceita condições políticas para garantir computação, crédito e defesa digital em 2029.",
    claimEn: "In the negative scenario, Brazil accepts political conditions to secure compute, credit, and cyber defense in 2029.",
    source: pt ? "Cenário negativo" : "Negative scenario", url: pt ? "/#2029-acesso-em-troca-de-alinhamento" : "/en#2029-access-in-exchange-for-alignment", checked: "28/08/2026",
  },
  {
    kind: "scenario", labelPt: "Invenção narrativa", labelEn: "Narrative invention", confidencePt: "Não se aplica", confidenceEn: "Not applicable",
    claimPt: "O cenário negativo projeta o maior número de desocupados da série histórica, fuga de talentos e a transformação do Brasil em um regime híbrido até 2030.",
    claimEn: "The negative scenario projects the largest number of unemployed people in the statistical series, talent flight, and Brazil's transformation into a hybrid regime by 2030.",
    source: pt ? "Cenário negativo" : "Negative scenario", url: pt ? "/#2030-país-satélite" : "/en#2030-satellite-country", checked: "28/08/2026",
  },
  {
    kind: "scenario", labelPt: "Invenção narrativa", labelEn: "Narrative invention", confidencePt: "Não se aplica", confidenceEn: "Not applicable",
    claimPt: "O Brasil propõe um canal técnico para incidentes na sessão da ONU de 2027, acompanha a declaração conjunta EUA–China de 2028 e obtém duas cláusulas no texto multilateral; o protocolo vinculante vem em 2029.",
    claimEn: "Brazil proposes a technical incident channel at the 2027 UN session, follows the 2028 US–China joint declaration, and secures two clauses in the multilateral text; the binding protocol comes in 2029.",
    source: pt ? "Cenário positivo" : "Positive scenario", url: pt ? "/#2028-a-coordenação-ganha-forma" : "/en#2028-coordination-takes-shape", checked: "27/08/2026",
  },
  {
    kind: "open", labelPt: "Proposta em aberto", labelEn: "Open proposal", confidencePt: "Aberta", confidenceEn: "Open",
    claimPt: "Uma desaceleração verificável exigiria limiares de capacidade, avaliações comuns, comunicação de incidentes e condições para retomar treinamento ou implantação. O projeto ainda precisa definir esses mecanismos.",
    claimEn: "A verifiable slowdown would require capability thresholds, shared evaluations, incident communication, and conditions for resuming training or deployment. The project still needs to define those mechanisms.",
    source: pt ? "Agenda de trabalho" : "Working agenda", url: pt ? "/estrategia" : "/en/strategy", checked: "07/08/2026",
  },
  {
    kind: "open", labelPt: "Em modelagem", labelEn: "Model pending", confidencePt: "Aberta", confidenceEn: "Open",
    claimPt: "Capacidade brasileira em 2030, parcela contratável e custo por trajetória. Pedro ainda está construindo o modelo.",
    claimEn: "Brazilian capacity in 2030, contractable share, and cost by trajectory. Pedro is still building the model.",
    source: pt ? "Modelo de Pedro" : "Pedro's model", url: pt ? "/evidencias#lacunas" : "/en/evidence#open-gaps", checked: "06/08/2026",
  },
];
const labels = pt ? {claim:"Afirmação", type:"Tipo", source:"Fonte", confidence:"Confiança", checked:"Verificada", all:"Todas", facts:"Fatos", estimates:"Estimativas", scenario:"Cenário", open:"Abertas"} : {claim:"Claim", type:"Type", source:"Source", confidence:"Confidence", checked:"Checked", all:"All", facts:"Facts", estimates:"Estimates", scenario:"Scenario", open:"Open"};
---
<BaseLayout locale={locale} pageKey="evidence" markdownHref={markdownRoutes[locale].evidence} title={pt ? "Evidências" : "Evidence"}>
  <PageHero compact locale={locale} eyebrow={pt ? "Registro de afirmações" : "Claim register"} title={pt ? "O que sabemos. O que inventamos." : "What we know. What we invented."} intro={pt ? "Cada afirmação recebe uma fonte, uma categoria e uma data de verificação. O site mantém as invenções do cenário visíveis em vez de apresentá-las como fatos." : "Each claim carries a source, a category, and a review date. The site keeps scenario inventions visible instead of presenting them as facts."} />
  <div class="page-content">
    <div class="evidence-toolbar">
      <div class="evidence-filter" role="group" aria-label={pt ? "Filtrar evidências" : "Filter evidence"} hidden>
        <button class="filter-button" type="button" data-filter="all" aria-pressed="true">{labels.all}</button>
        <button class="filter-button" type="button" data-filter="fact" aria-pressed="false">{labels.facts}</button>
        <button class="filter-button" type="button" data-filter="estimate" aria-pressed="false">{labels.estimates}</button>
        <button class="filter-button" type="button" data-filter="scenario" aria-pressed="false">{labels.scenario}</button>
        <button class="filter-button" type="button" data-filter="open" aria-pressed="false">{labels.open}</button>
      </div>
      <span class="status-line" data-evidence-count data-one={pt ? "item" : "item"} data-many={pt ? "itens" : "items"} aria-live="polite" aria-atomic="true"><span class="status-dot"></span><span data-count-text>{evidence.length} {pt ? "itens" : "items"}</span></span>
    </div>
    <table class="evidence-table">
      <thead><tr><th>{labels.claim}</th><th>{labels.type}</th><th>{labels.source}</th><th>{labels.confidence}</th><th>{labels.checked}</th></tr></thead>
      <tbody>
        {evidence.map((item) => <tr data-evidence-kind={item.kind}>
          <td data-label={labels.claim}>{pt ? item.claimPt : item.claimEn}</td>
          <td data-label={labels.type}><span class={`tag ${item.kind}`}>{pt ? item.labelPt : item.labelEn}</span></td>
          <td data-label={labels.source}><a href={item.url}>{item.source}</a></td>
          <td data-label={labels.confidence} class="confidence">{pt ? item.confidencePt : item.confidenceEn}</td>
          <td data-label={labels.checked}>{item.checked}</td>
        </tr>)}
      </tbody>
    </table>

    <section id={pt ? "metodo" : "method"} class="narrow-content">
      <h2>{pt ? "Método" : "Method"}</h2>
      <p>{pt ? "A equipe separa fatos observados, estimativas dos autores, premissas emprestadas de outros cenários e invenções narrativas. Uma estimativa não ganha confiança por aparecer ao lado de um número preciso." : "The team separates observed facts, author estimates, assumptions borrowed from other scenarios, and narrative inventions. An estimate does not gain confidence because it appears beside a precise number."}</p>
      <p>{pt ? "A faixa de 0,1% a 0,5% para a participação brasileira em computação combina dados de carga de data centers e indicadores de supercomputação. Ela não mede o estoque privado de aceleradores e deve permanecer rotulada como hipótese." : "The 0.1% to 0.5% range for Brazil's compute share combines data-center load and supercomputing indicators. It does not measure the private accelerator stock and must remain labeled as a hypothesis."}</p>
    </section>
    <section id={pt ? "lacunas" : "open-gaps"} class="narrow-content">
      <h2>{pt ? "Lacunas abertas" : "Open gaps"}</h2>
      <p>{pt ? "O modelo de Pedro definirá as trajetórias de capacidade até 2030. A equipe ainda precisa especificar os limiares de uma desaceleração verificável, rever o status do REDATA, confirmar termos públicos de Pecém e validar os instrumentos jurídicos sugeridos na Estratégia." : "Pedro's model will define capacity trajectories through 2030. The team still needs to specify thresholds for a verifiable slowdown, refresh REDATA's status, confirm public Pecém terms, and review the legal instruments proposed in the Strategy."}</p>
    </section>
  </div>
  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-filter]'));
      const rows = Array.from(document.querySelectorAll('[data-evidence-kind]'));
      const filterGroup = document.querySelector('.evidence-filter');
      const countRegion = document.querySelector('[data-evidence-count]');
      const countText = countRegion?.querySelector('[data-count-text]');
      if (filterGroup) filterGroup.hidden = false;
      buttons.forEach((button) => button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
        rows.forEach((row) => { row.hidden = filter !== 'all' && row.getAttribute('data-evidence-kind') !== filter; });
        const visibleCount = rows.filter((row) => !row.hidden).length;
        const noun = visibleCount === 1 ? countRegion?.getAttribute('data-one') : countRegion?.getAttribute('data-many');
        if (countText) countText.textContent = `${visibleCount} ${noun || ''}`.trim();
      }));
    })();
  </script>
</BaseLayout>
