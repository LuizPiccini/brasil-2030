---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { markdownRoutes, routes, type Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === "pt";
const items = pt ? [
  { title: "Defender uma desaceleração verificável", body: "Propor limites recíprocos para treinamento e implantação acima de limiares de risco. Avaliações comuns, comunicação de incidentes e critérios públicos devem definir quando interromper e quando retomar o avanço.", actor: "Responsáveis", owner: "Presidência, Itamaraty, MCTI e parceiros internacionais" },
  { title: "Abrir um canal entre China e Estados Unidos", body: "Oferecer mediação brasileira para conversas técnicas sobre avaliações, incidentes graves e limites de implantação. O objetivo é criar medidas que cada lado consiga verificar sem depender de confiança política.", actor: "Responsáveis", owner: "Itamaraty, Presidência e comunidade científica" },
  { title: "Preparar o Brasil para uma falha de coordenação", body: "Designar uma autoridade permanente para riscos avançados de IA, mapear dependências estrangeiras e exercitar respostas em finanças, energia, comunicações e serviços públicos.", actor: "Responsáveis", owner: "Presidência, GSI, reguladores e infraestrutura crítica" },
  { title: "Construir soberania de inferência", body: "Expandir transmissão, geração e data centers com capacidade contratável, uma porta brasileira de contratação, limites hídricos, consulta às comunidades e continuidade para serviços críticos.", actor: "Responsáveis", owner: "Congresso, MME, estados, BNDES e operadores" },
  { title: "Medir e revisar os resultados", body: "Publicar capacidade contratável, consumo de água, custo da rede e empregos permanentes. Revisões independentes e datas de expiração devem encerrar programas que não entreguem benefício público.", actor: "Responsáveis", owner: "TCU, CGU, academia e sociedade civil" },
] : [
  { title: "Support a verifiable slowdown", body: "Propose reciprocal limits on training and deployment above agreed risk thresholds. Shared evaluations, incident communication, and public criteria should determine when development stops and resumes.", actor: "Responsible actors", owner: "Presidency, Foreign Ministry, MCTI, and international partners" },
  { title: "Open a channel between China and the United States", body: "Offer Brazilian mediation for technical talks on evaluations, severe incidents, and deployment limits. Each side must be able to verify the measures without relying on political trust.", actor: "Responsible actors", owner: "Foreign Ministry, Presidency, and scientific community" },
  { title: "Prepare Brazil for coordination failure", body: "Designate a permanent authority for advanced AI risks, map foreign dependencies, and exercise responses across finance, energy, communications, and public services.", actor: "Responsible actors", owner: "Presidency, GSI, regulators, and critical infrastructure" },
  { title: "Build inference sovereignty", body: "Expand transmission, generation, and data centers with contractable capacity, a Brazilian contracting door, water limits, community consultation, and continuity for critical services.", actor: "Responsible actors", owner: "Congress, MME, states, BNDES, and operators" },
  { title: "Measure and review results", body: "Publish contractable capacity, water consumption, grid costs, and permanent jobs. Independent review and expiry dates should end programs that fail to deliver public benefits.", actor: "Responsible actors", owner: "TCU, CGU, academia, and civil society" },
];
---
<BaseLayout locale={locale} pageKey="strategy" markdownHref={markdownRoutes[locale].strategy} title={pt ? "Estratégia" : "Strategy"}>
  <PageHero compact locale={locale} eyebrow={pt ? "Cinco compromissos" : "Five commitments"} title={pt ? "Ganhar tempo e poder de barganha" : "Gain time and bargaining power"} intro={pt ? "O Brasil pode defender uma desaceleração global, preparar-se para seu fracasso e usar energia para negociar a capacidade de inferência necessária à própria defesa." : "Brazil can support a global slowdown, prepare for its failure, and use energy to negotiate the inference capacity required for its own defense."} />
  <div class="page-content">
    <div class="callout">{pt ? "A estratégia precisa funcionar nos dois cenários. Se o acordo internacional avançar, a capacidade aumenta nossa influência. Se falhar, ela protege serviços críticos e reduz a dependência." : "The strategy must work in both scenarios. If international coordination advances, capacity increases Brazil's influence. If it fails, capacity protects critical services and reduces dependency."}</div>
    <div class="strategy-list">
      {items.map((item, index) => <article class="strategy-item">
        <span class="strategy-number">{String(index + 1).padStart(2, "0")}</span>
        <div><h2>{item.title}</h2><p>{item.body}</p></div>
        <div class="strategy-owner"><strong>{item.actor}</strong>{item.owner}</div>
      </article>)}
    </div>

    <section class="narrow-content">
      <h2>{pt ? "O significado de desacelerar" : "The meaning of slowdown"}</h2>
      <p>{pt ? "Uma pausa genérica não oferece uma regra aplicável. O acordo precisa identificar capacidades, limiares e avaliações que acionem limites recíprocos, além das condições para retomar treinamento ou implantação." : "A generic pause offers no workable rule. An agreement needs capabilities, thresholds, and evaluations that trigger reciprocal limits, plus conditions for resuming training or deployment."}</p>
      <p>{pt ? "A política para data centers também precisa de condições mensuráveis. Pilotos devem medir preço, acesso durante incidentes, consumo de água, custo da rede e empregos permanentes antes que benefícios se tornem direitos adquiridos." : "Data-center policy also needs measurable conditions. Pilots should measure price, access during incidents, water use, grid costs, and permanent jobs before benefits become entrenched."}</p>
      <p><a class="button-link" href={routes[locale].redata}>{pt ? "Ler as cinco propostas para o REDATA" : "Read the five REDATA proposals"}</a></p>
    </section>

    <section class="narrow-content">
      <h2>{pt ? "Da estratégia à carta" : "From strategy to letter"}</h2>
      <p>{pt ? "A carta aberta traduz estes compromissos para candidatos e equipes de governo. Ela permanece em elaboração enquanto o grupo revisa os pedidos e responsáveis." : "The open letter translates these commitments for candidates and transition teams. It remains in development while the group reviews its requests and responsible actors."}</p>
      <p><a class="button-link" href={routes[locale].letter}>{pt ? "Ler a carta em elaboração" : "Read the draft letter"}</a></p>
    </section>
  </div>
</BaseLayout>
