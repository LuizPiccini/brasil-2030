---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScenarioCommonPt from "../content/scenario-common-pt.md";
import ScenarioNegativePt from "../content/scenario-negative-pt.md";
import { markdownRoutes, routes, siteCopy, type Locale } from "../data/site";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === "pt";
const copy = siteCopy[locale];
const CommonContent = ScenarioCommonPt;
const ScenarioContent = ScenarioNegativePt;

const text = pt ? {
  eyebrow: "Uma trajetória para o Brasil",
  titleCountry: "Brasil 2030",
  titleLine: "Energia para Escolher",
  deck: "As mesmas pressões globais chegam a todos os países. Este cenário segue o que acontece com o Brasil quando o país não constrói capacidade própria antes de precisar dela.",
  summary: "Resumo de 5 minutos",
  disclaimer: "Este cenário não é uma previsão. Ele parte de condições observadas até setembro de 2026 e testa quanto as escolhas brasileiras mudam a posição do país em 2030. A trajetória descrita é a que resulta de falhas plausíveis, não de má sorte: cada erro tinha uma alternativa conhecida em 2026.",
  timeline: "Linha do tempo",
  current: "Capítulo",
  panelTitle: "Estado do Brasil",
  panelStatus: "trajetória qualitativa",
  scale: "Escala de cenário, 1 a 5",
  scoreUnit: "de 5",
  changed: "O que mudou",
  note: "O painel resume a trajetória do cenário. Não mede o Brasil real.",
  arcTitle: "O arco em uma frase",
  arcBody: "O Brasil oferece energia, território e mercado antes de contratar acesso e continuidade, e chega ao acordo internacional de 2029 sem nada para pôr na mesa.",
} : {
  eyebrow: "One trajectory for Brazil",
  titleCountry: "Brazil 2030",
  titleLine: "The Energy to Choose",
  deck: "The same global pressures reach every country. This scenario follows what happens to Brazil when the country fails to build its own capacity before it needs it.",
  summary: "Five-minute summary",
  disclaimer: "This scenario is not a forecast. It starts from conditions observed through September 2026 and tests how much Brazilian choices change the country's position in 2030. The trajectory described follows from plausible failures, not bad luck: every mistake had a known alternative in 2026.",
  timeline: "Timeline",
  current: "Chapter",
  panelTitle: "State of Brazil",
  panelStatus: "qualitative trajectory",
  scale: "Scenario scale, 1 to 5",
  scoreUnit: "of 5",
  changed: "What changed",
  note: "This panel summarizes the scenario's trajectory. It does not measure real-world Brazil.",
  arcTitle: "The arc in one sentence",
  arcBody: "Brazil commits energy, land, and market access before contracting capacity and continuity, and arrives at the 2029 international agreement with nothing to put on the table.",
};

const chapters = pt ? [
  { year: "2026", label: "A decisão", href: "#2026-o-ponto-de-bifurcação" },
  { year: "2027", label: "Crise interna", href: "#2027-ataques-demissões-e-poderes-de-emergência" },
  { year: "2028", label: "Acordo dos outros", href: "#2028-o-acordo-dos-outros" },
  { year: "2029", label: "Alinhamento", href: "#2029-acesso-em-troca-de-alinhamento" },
  { year: "2030", label: "País satélite", href: "#2030-país-satélite" },
] : [
  { year: "2026", label: "The decision", href: "#2026-the-branching-point" },
  { year: "2027", label: "Domestic crisis", href: "#2027-attacks-layoffs-and-emergency-powers" },
  { year: "2028", label: "Others' agreement", href: "#2028-someone-elses-agreement" },
  { year: "2029", label: "Alignment", href: "#2029-access-in-exchange-for-alignment" },
  { year: "2030", label: "Satellite country", href: "#2030-satellite-country" },
];

const dashboardStates = pt ? [
  { date: "Set 2026", title: "A primeira barganha", summary: "O REDATA é aprovado sem transformar presença física em acesso brasileiro: os 10% do mercado interno são medidos em receita e podem virar P&D.", tracks: [["risk", "Risco sistêmico", 2, "em alta"], ["leverage", "Alavanca brasileira", 2, "potencial"], ["sovereignty", "Soberania de inferência", 1, "fraca"]], facts: [["Coordenação", "diálogo inicial"], ["Infraestrutura", "projetos anunciados"], ["Acesso", "sem garantia"]], focus: "Energia e rede são comprometidas antes que o Brasil negocie capacidade e continuidade.", mobile: "Risco em alta · Sem garantia" },
  { date: "2027", title: "Crise interna", summary: "Ataques, automação importada e poderes de emergência pressionam trabalho e instituições.", tracks: [["risk", "Risco sistêmico", 5, "crítico"], ["leverage", "Alavanca brasileira", 2, "física"], ["sovereignty", "Soberania de inferência", 1, "dependente"]], facts: [["Coordenação", "pressão por acordo"], ["Infraestrutura", "enclaves"], ["Acesso", "defesa importada"]], focus: "Grandes organizações compram proteção; trabalhadores e serviços menores absorvem o custo.", mobile: "Crise interna · Defesa importada" },
  { date: "2028", title: "O acordo dos outros", summary: "EUA e China desaceleram sob termos que preservam sua vantagem e não garantem acesso ao Brasil.", tracks: [["risk", "Risco sistêmico", 3, "contido"], ["leverage", "Alavanca brasileira", 1, "ausente"], ["sovereignty", "Soberania de inferência", 1, "restrita"]], facts: [["Coordenação", "acordo excludente"], ["Infraestrutura", "sem capacidade própria"], ["Acesso", "sem garantia"]], focus: "O Brasil é convidado a apoiar o texto e não consegue dizer que clusters oferece à verificação.", mobile: "Acordo excludente · Brain drain" },
  { date: "2029", title: "Acesso por alinhamento", summary: "O governo aceita condições políticas para garantir computação, crédito e defesa digital.", tracks: [["risk", "Risco sistêmico", 3, "contido"], ["leverage", "Alavanca brasileira", 1, "perdida"], ["sovereignty", "Soberania de inferência", 1, "terceirizada"]], facts: [["Coordenação", "acordo mantido"], ["Infraestrutura", "decisão externa"], ["Acesso", "condicionado"]], focus: "Dois anos depois da primeira exigência, o prazo em que Emirados e Reino Unido cederam, o Brasil escolhe sob pressão.", mobile: "Acesso condicionado · Escolha forçada" },
  { date: "2030", title: "País satélite", summary: "Desemprego recorde em número absoluto, fuga de talentos e uma posição definida por outros.", tracks: [["risk", "Risco sistêmico", 4, "em alta de novo"], ["leverage", "Alavanca brasileira", 1, "perdida"], ["sovereignty", "Soberania de inferência", 1, "mínima"]], facts: [["Coordenação", "protocolo por um fio"], ["Infraestrutura", "acesso revogável"], ["Acesso", "por alinhamento"]], focus: "A tensão entre as potências chega ao Brasil como corte de cota, meses antes de qualquer disparo.", mobile: "País satélite · Cota cortada" },
] : [
  { date: "Sep 2026", title: "The first bargain", summary: "REDATA passes without turning physical presence into Brazilian access: the 10% domestic share is measured as revenue and can be swapped for R&D.", tracks: [["risk", "Systemic risk", 2, "rising"], ["leverage", "Brazilian leverage", 2, "potential"], ["sovereignty", "Inference sovereignty", 1, "weak"]], facts: [["Coordination", "early dialogue"], ["Infrastructure", "projects announced"], ["Access", "not guaranteed"]], focus: "Energy and grid access are committed before Brazil negotiates capacity and continuity.", mobile: "Risk rising · No guarantee" },
  { date: "2027", title: "Domestic crisis", summary: "Attacks, imported automation, and emergency powers put pressure on jobs and institutions.", tracks: [["risk", "Systemic risk", 5, "critical"], ["leverage", "Brazilian leverage", 2, "physical"], ["sovereignty", "Inference sovereignty", 1, "dependent"]], facts: [["Coordination", "pressure for a deal"], ["Infrastructure", "enclaves"], ["Access", "imported defense"]], focus: "Large organizations buy protection while workers and smaller services absorb the cost.", mobile: "Domestic crisis · Imported defense" },
  { date: "2028", title: "Someone else's agreement", summary: "The US and China slow down under terms that preserve their advantage and do not guarantee access to Brazil.", tracks: [["risk", "Systemic risk", 3, "contained"], ["leverage", "Brazilian leverage", 1, "absent"], ["sovereignty", "Inference sovereignty", 1, "restricted"]], facts: [["Coordination", "exclusive agreement"], ["Infrastructure", "no domestic capacity"], ["Access", "not guaranteed"]], focus: "Brazil is invited to support the text and cannot say which clusters it can offer for verification.", mobile: "Exclusive deal · Brain drain" },
  { date: "2029", title: "Access through alignment", summary: "The government accepts political conditions to secure compute, credit, and cyber defense.", tracks: [["risk", "Systemic risk", 3, "contained"], ["leverage", "Brazilian leverage", 1, "lost"], ["sovereignty", "Inference sovereignty", 1, "outsourced"]], facts: [["Coordination", "agreement holds"], ["Infrastructure", "foreign decision"], ["Access", "conditional"]], focus: "Two years after the first demand, the same span in which the UAE and the UK gave way, Brazil chooses under pressure.", mobile: "Conditional access · Forced choice" },
  { date: "2030", title: "Satellite country", summary: "Record unemployment in absolute numbers, talent flight, and a position defined by others.", tracks: [["risk", "Systemic risk", 4, "rising again"], ["leverage", "Brazilian leverage", 1, "lost"], ["sovereignty", "Inference sovereignty", 1, "minimal"]], facts: [["Coordination", "protocol by a thread"], ["Infrastructure", "revocable access"], ["Access", "through alignment"]], focus: "Great-power tension reaches Brazil as a quota cut, months before any shot is fired.", mobile: "Satellite country · Quota cut" },
];

const initialState = dashboardStates[0];
---

{!pt && (
  <BaseLayout locale={locale} pageKey="scenario" bodyClass="scenario-page">
    <section class="scenario-hero">
      <div class="hero-inner">
        <div>
          <p class="eyebrow">Translation in progress</p>
          <h1>Brazil 2030<span>The Energy to Choose</span></h1>
          <p class="hero-deck">The scenario was substantially rewritten in September 2026 and the English edition is being retranslated from scratch. The previous English text has been withdrawn rather than left to describe a version that no longer exists.</p>
          <div class="hero-actions">
            <a class="button-link primary" href={routes.pt.scenario}>Read the scenario in Portuguese</a>
            <a class="button-link" href={routes.en.summary}>Five-minute summary</a>
          </div>
        </div>
      </div>
    </section>
    <section class="scenario-disclaimer" aria-label="Editorial note"><p>The other English pages (summary, strategy, evidence, REDATA, and the open letter) remain current.</p></section>
  </BaseLayout>
)}
{pt && (
<BaseLayout locale={locale} pageKey="scenario" markdownHref={markdownRoutes[locale].scenario} bodyClass="scenario-page branch-scenario-page">
  <section class="scenario-hero">
    <div class="hero-inner">
      <div>
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.titleCountry}<span>{text.titleLine}</span></h1>
        <p class="hero-deck">{text.deck}</p>
        <div class="status-line">
          <span class="status-dot" aria-hidden="true"></span><span>{copy.status}</span><span class="status-separator" aria-hidden="true"></span><time datetime="2026-09-09">{copy.updated}</time>
        </div>
        <div class="hero-actions">
          <a class="button-link primary negative-action" href="#2026-o-ponto-de-bifurcação">{pt ? "Começar em 2026" : "Start in 2026"}</a>
          <a class="button-link" href={routes[locale].summary}>{text.summary}</a>
        </div>
      </div>
      <div class="scenario-hero-branches" aria-label={text.arcTitle}>
        <article class="hero-branch hero-branch-negative"><span>{text.arcTitle}</span><strong>{pt ? "País satélite" : "Satellite country"}</strong><p>{text.arcBody}</p></article>
      </div>
    </div>
  </section>

  <section class="scenario-disclaimer" aria-label={pt ? "Nota editorial" : "Editorial note"}><p>{text.disclaimer}</p></section>

  <div class="reading-layout">
    <nav class="chapter-nav" aria-label={text.timeline}>
      <span class="chapter-nav-label">{text.timeline}</span>
      <ol>
        {chapters.map((chapter, index) => (
          <li><a class={index === 0 ? "is-active" : ""} href={chapter.href} data-chapter-label={`${chapter.year}: ${chapter.label}`} aria-current={index === 0 ? "location" : undefined}><span>{chapter.year}</span><span>{chapter.label}</span></a></li>
        ))}
      </ol>
    </nav>

    <article class="scenario-prose">
      <CommonContent />
      <ScenarioContent />
    </article>

    <aside class="reading-aside">
      <section class="scenario-dashboard" data-scenario-dashboard data-states={JSON.stringify(dashboardStates)} data-score-unit={text.scoreUnit} aria-labelledby="scenario-dashboard-title">
        <header class="dashboard-header"><div><span class="dashboard-eyebrow">{text.panelTitle}</span><span class="dashboard-qualifier">{text.panelStatus}</span></div><time data-dashboard-date>{initialState.date}</time></header>
        <div class="dashboard-copy"><h2 id="scenario-dashboard-title" data-dashboard-title>{initialState.title}</h2><p data-dashboard-summary>{initialState.summary}</p></div>
        <div class="dashboard-tracks" aria-label={text.scale}>
          {initialState.tracks.map(([key, label, score, value]) => (
            <div class={`dashboard-track dashboard-track-${key}`} data-dashboard-track={key}>
              <div class="dashboard-track-label"><span>{label}</span><strong data-track-value>{value}</strong></div>
              <div class="dashboard-track-dots" data-track-dots role="img" aria-label={`${label}: ${value}, ${score} ${text.scoreUnit}`}>{Array.from({ length: 5 }).map((_, index) => <span class={index < Number(score) ? "is-filled" : ""} data-track-dot aria-hidden="true"></span>)}</div>
            </div>
          ))}
        </div>
        <dl class="dashboard-facts">{initialState.facts.map(([label, value]) => <div><dt>{label}</dt><dd data-dashboard-fact>{value}</dd></div>)}</dl>
        <div class="dashboard-focus"><span>{text.changed}</span><p data-dashboard-focus>{initialState.focus}</p></div>
        <p class="dashboard-note">{text.note}</p>
      </section>
    </aside>
  </div>

  <div class="mobile-chapter-bar" aria-live="polite"><span>{text.current}</span><span class="mobile-chapter-copy"><span data-current-chapter>{chapters[0].year}: {chapters[0].label}</span><small data-mobile-state>{initialState.mobile}</small></span><a href="#main-content" aria-label={pt ? "Voltar ao início" : "Back to top"}>↑</a></div>

  <script is:inline>
    (() => {
      document.body.setAttribute('data-scenario-branch', 'negative');
      const dashboard = document.querySelector('[data-scenario-dashboard]');
      const mobileLabel = document.querySelector('[data-current-chapter]');
      const mobileState = document.querySelector('[data-mobile-state]');
      const scoreUnit = dashboard?.getAttribute('data-score-unit') || '';
      let states = [];
      try { states = JSON.parse(dashboard?.getAttribute('data-states') || '[]'); } catch { states = []; }

      const setDashboard = (index) => {
        const state = states[index];
        if (!dashboard || !state) return;
        const setText = (selector, value) => { const element = dashboard.querySelector(selector); if (element) element.textContent = value; };
        setText('[data-dashboard-date]', state.date);
        setText('[data-dashboard-title]', state.title);
        setText('[data-dashboard-summary]', state.summary);
        setText('[data-dashboard-focus]', state.focus);
        dashboard.querySelectorAll('[data-dashboard-track]').forEach((trackElement, trackIndex) => {
          const [key, label, score, value] = state.tracks[trackIndex] || [];
          if (!key) return;
          const valueElement = trackElement.querySelector('[data-track-value]');
          if (valueElement) valueElement.textContent = value;
          trackElement.querySelectorAll('[data-track-dot]').forEach((dot, dotIndex) => dot.classList.toggle('is-filled', dotIndex < score));
          const group = trackElement.querySelector('[data-track-dots]');
          if (group) group.setAttribute('aria-label', `${label}: ${value}, ${score} ${scoreUnit}`);
        });
        dashboard.querySelectorAll('[data-dashboard-fact]').forEach((fact, factIndex) => { if (state.facts[factIndex]) fact.textContent = state.facts[factIndex][1]; });
        dashboard.setAttribute('data-state-index', String(index));
        if (mobileState) mobileState.textContent = state.mobile;
      };

      const links = Array.from(document.querySelectorAll('.chapter-nav a'));
      const entries = links.map((link) => { const id = decodeURIComponent(link.getAttribute('href')?.slice(1) || ''); const section = document.getElementById(id); return section ? { link, section } : null; }).filter(Boolean);

      const updateActiveChapter = () => {
        if (!entries.length) return;
        const readingLine = Math.max(96, window.innerHeight * 0.18);
        let activeEntry = entries[0];
        entries.forEach((entry) => { if (entry.section.getBoundingClientRect().top <= readingLine) activeEntry = entry; });
        entries.forEach(({ link }) => { const active = link === activeEntry.link; link.classList.toggle('is-active', active); if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
        if (mobileLabel) mobileLabel.textContent = activeEntry.link.getAttribute('data-chapter-label') || '';
        setDashboard(entries.indexOf(activeEntry));
      };

      let framePending = false;
      const requestUpdate = () => { if (framePending) return; framePending = true; window.requestAnimationFrame(() => { updateActiveChapter(); framePending = false; }); };
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
      window.addEventListener('load', requestUpdate, { once: true });
      document.fonts?.ready.then(requestUpdate);
      updateActiveChapter();
    })();
  </script>
</BaseLayout>
)}
