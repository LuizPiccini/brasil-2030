---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { markdownRoutes, routes, type Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === "pt";
const conclusions = pt ? [
  ["Desacelerar a corrida", "O Brasil deve apoiar limites recíprocos e verificáveis para o desenvolvimento e a implantação de sistemas que ultrapassem limiares de risco."],
  ["Abrir canais entre potências", "A diplomacia brasileira pode aproximar Estados Unidos e China em torno de avaliações, incidentes graves e condições para interromper uma escalada."],
  ["Transformar energia em soberania", "Rede e data centers criam poder de barganha quando contratos garantem inferência e os projetos assumem custos hídricos, elétricos e territoriais."],
] : [
  ["Slow the race", "Brazil should support reciprocal and verifiable limits on the development and deployment of systems that cross agreed risk thresholds."],
  ["Open channels between major powers", "Brazilian diplomacy can bring the United States and China together around evaluations, severe incidents, and conditions for interrupting escalation."],
  ["Turn energy into sovereignty", "Grid access and data centers create bargaining power when contracts guarantee inference and projects bear their water, power-system, and territorial costs."],
];
const branches = pt ? [
  {
    kind: "positive", label: "Cenário positivo", title: "Coordenação e margem de escolha",
    years: [["2026", "REDATA passa com acesso e fiscalização"], ["2027", "Ataques encontram defesa local e estrangeira"], ["2028", "Brasil ajuda a costurar um acordo limitado"], ["2029", "Energia e compute sustentam negociações"], ["2030", "Brasil se torna uma potência intermediária"]],
  },
  {
    kind: "negative", label: "Cenário negativo", title: "Corrida e dependência",
    years: [["2026", "REDATA falha ou cria apenas enclaves"], ["2027", "Ataques produzem interrupções e dependência"], ["2028", "A corrida continua sem acordo"], ["2029", "Controles externos forçam alinhamento"], ["2030", "Brasil opera sob as regras de um bloco"]],
  },
] : [
  {
    kind: "positive", label: "Positive scenario", title: "Coordination and room to choose",
    years: [["2026", "REDATA passes with access and oversight"], ["2027", "Attacks meet local and foreign defenses"], ["2028", "Brazil helps broker a limited agreement"], ["2029", "Energy and compute support negotiations"], ["2030", "Brazil becomes a middle power"]],
  },
  {
    kind: "negative", label: "Negative scenario", title: "Race and dependence",
    years: [["2026", "REDATA fails or creates enclaves"], ["2027", "Attacks create outages and dependence"], ["2028", "The race continues without an agreement"], ["2029", "Foreign controls force alignment"], ["2030", "Brazil operates under one bloc's rules"]],
  },
];
---
<BaseLayout locale={locale} pageKey="summary" markdownHref={markdownRoutes[locale].summary} title={pt ? "Resumo" : "Summary"}>
  <PageHero locale={locale} eyebrow={pt ? "Leitura em cinco minutos" : "A five-minute read"} title={pt ? "Duas trajetórias, três compromissos" : "Two paths, three commitments"} intro={pt ? "Os dois cenários enfrentam ataques, automação e disputa geopolítica. As escolhas de 2026 determinam se energia e data centers ampliam a margem brasileira ou aprofundam a dependência." : "Both scenarios face attacks, automation, and geopolitical competition. Choices made in 2026 determine whether energy and data centers expand Brazil's options or deepen dependency."} />
  <div class="page-content">
    <div class="callout">{pt ? "O Brasil deve tentar desacelerar a corrida e construir capacidade doméstica mesmo se a coordenação falhar. Uma política funciona como prevenção; a outra, como seguro." : "Brazil should try to slow the race and build domestic capacity even if coordination fails. One policy provides prevention; the other provides insurance."}</div>
    <section aria-labelledby="conclusions-title">
      <h2 id="conclusions-title">{pt ? "Três compromissos públicos" : "Three public commitments"}</h2>
      <div class="summary-grid">
        {conclusions.map(([title, body], index) => <article class="summary-card"><span class="card-index">0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>
    <section aria-labelledby="timeline-title">
      <h2 id="timeline-title">{pt ? "Os dois caminhos" : "The two paths"}</h2>
      <div class="branch-summary-grid">
        {branches.map((branch) => <article class={`branch-summary branch-summary-${branch.kind}`}><span>{branch.label}</span><h3>{branch.title}</h3><ol>{branch.years.map(([year, body]) => <li><time>{year}</time><p>{body}</p></li>)}</ol></article>)}
      </div>
    </section>
    <section class="narrow-content">
      <h2>{pt ? "O seguro contra uma falha de coordenação" : "Insurance against coordination failure"}</h2>
      <p>{pt ? "A diplomacia pode chegar tarde ou produzir um acordo fraco. O Brasil precisa inventariar dependências, testar modelos usados em serviços críticos, exercitar respostas a ataques e reservar capacidade defensiva antes da crise." : "Diplomacy may arrive late or produce a weak agreement. Brazil needs to inventory dependencies, test models used in critical services, exercise attack response, and reserve defensive capacity before a crisis."}</p>
      <p class="hero-actions"><a class="button-link primary" href={routes[locale].strategy}>{pt ? "Ver a estratégia" : "Read the strategy"}</a><a class="button-link" href={routes[locale].redata}>{pt ? "Ver propostas para o REDATA" : "Read the REDATA proposals"}</a></p>
    </section>
  </div>
</BaseLayout>
