---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { markdownRoutes, routes, type Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === "pt";
const conclusions = pt ? [
  ["Desacelerar a corrida", "O Brasil deve apoiar limites recíprocos e verificáveis para o desenvolvimento e a implantação de sistemas que ultrapassem limiares de risco."],
  ["Abrir canais entre potências", "A diplomacia brasileira pode aproximar Estados Unidos e China em torno de avaliações, incidentes graves e condições para interromper uma escalada."],
  ["Transformar energia em soberania", "Rede e data centers criam poder de barganha quando contratos garantem inferência e os projetos assumem custos hídricos, elétricos e territoriais."],
] : [
  ["Slow the race", "Brazil should support reciprocal and verifiable limits on the development and deployment of systems that cross agreed risk thresholds."],
  ["Open channels between major powers", "Brazilian diplomacy can bring the United States and China together around evaluations, severe incidents, and conditions for interrupting escalation."],
  ["Turn energy into sovereignty", "Grid access and data centers create bargaining power when contracts guarantee inference and projects bear their water, power-system, and territorial costs."],
];
const branches = pt ? [
  {
    kind: "negative", label: "Cenário", title: "País satélite",
    years: [["2026", "REDATA é aprovado sem criar capacidade contratável"], ["2027", "Ataques, fechamento da porta de entrada e poderes de emergência"], ["2028", "EUA e China fecham um acordo que preserva sua vantagem"], ["2029", "Brasil troca alinhamento por acesso"], ["2030", "Desemprego recorde, fuga de talentos e posição definida por outros"]],
  },
] : [
  {
    kind: "negative", label: "Scenario", title: "Satellite country",
    years: [["2026", "REDATA passes without creating contractable capacity"], ["2027", "Attacks, a closing entry door, and emergency powers"], ["2028", "The US and China strike a deal that preserves their advantage"], ["2029", "Brazil trades alignment for access"], ["2030", "Record unemployment, talent flight, and a position set by others"]],
  },
];
---
<BaseLayout locale={locale} pageKey="summary" markdownHref={markdownRoutes[locale].summary} title={pt ? "Resumo" : "Summary"}>
  <PageHero locale={locale} eyebrow={pt ? "Leitura em cinco minutos" : "A five-minute read"} title={pt ? "Uma trajetória, três compromissos" : "One trajectory, three commitments"} intro={pt ? "O cenário enfrenta ataques, automação e disputa geopolítica. As escolhas de 2026 determinam se energia e data centers ampliam a margem brasileira ou aprofundam a dependência." : "The scenario runs through attacks, automation, and geopolitical competition. Choices made in 2026 determine whether energy and data centers expand Brazil's options or deepen dependency."} />
  <div class="page-content">
    <div class="callout">{pt ? "O acordo internacional reduz parte do risco global. A capacidade doméstica define se o Brasil participa das decisões ou aceita regras externas para manter seus sistemas funcionando." : "The international agreement reduces part of the global risk. Domestic capacity determines whether Brazil helps make decisions or accepts external rules to keep its systems running."}</div>
    <section aria-labelledby="conclusions-title">
      <h2 id="conclusions-title">{pt ? "Três compromissos públicos" : "Three public commitments"}</h2>
      <div class="summary-grid">
        {conclusions.map(([title, body], index) => <article class="summary-card"><span class="card-index">0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>
    <section aria-labelledby="timeline-title">
      <h2 id="timeline-title">{pt ? "O caminho descrito" : "The trajectory described"}</h2>
      <div class="branch-summary-grid">
        {branches.map((branch) => <article class={`branch-summary branch-summary-${branch.kind}`}><span>{branch.label}</span><h3>{branch.title}</h3><ol>{branch.years.map(([year, body]) => <li><time>{year}</time><p>{body}</p></li>)}</ol></article>)}
      </div>
    </section>
    <section class="narrow-content">
      <h2>{pt ? "O acordo não distribui soberania" : "The agreement does not distribute sovereignty"}</h2>
      <p>{pt ? "EUA e China podem reduzir o ritmo da fronteira sem dividir chips, capacidade defensiva ou poder de decisão. O Brasil precisa inventariar dependências, testar modelos usados em serviços críticos e reservar capacidade antes da crise." : "The United States and China may slow the frontier without sharing chips, defensive capacity, or decision-making power. Brazil needs to inventory dependencies, test models used in critical services, and reserve capacity before a crisis."}</p>
      <p class="hero-actions"><a class="button-link primary" href={routes[locale].strategy}>{pt ? "Ver a estratégia" : "Read the strategy"}</a><a class="button-link" href={routes[locale].redata}>{pt ? "Ver propostas para o REDATA" : "Read the REDATA proposals"}</a></p>
    </section>
  </div>
</BaseLayout>
