---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { markdownRoutes, routes, type Locale } from "../data/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const pt = locale === "pt";

const metrics = pt ? [
  ["10%", "oferta doméstica prevista", "Hoje aferida pela participação da receita brasileira na receita total."],
  ["2%", "investimento obrigatório em P&D", "Calculado sobre os equipamentos adquiridos com o benefício."],
  ["0,05", "litro por kWh", "Limite anual de eficiência hídrica previsto no texto da Câmara."],
  ["0/5", "pedidos centrais cobertos", "Nenhuma das 22 emendas resolve integralmente um dos cinco pedidos."],
] : [
  ["10%", "planned domestic supply", "Currently measured through Brazilian revenue as a share of total revenue."],
  ["2%", "mandatory R&D investment", "Calculated over equipment acquired with the tax benefit."],
  ["0.05", "liter per kWh", "Annual water-efficiency threshold in the Chamber text."],
  ["0/5", "core requests covered", "None of the 22 amendments fully resolves one of the five requests."],
];

const changes = pt ? [
  { number: "01", title: "Medir capacidade contratável", body: "Aferir os 10% em horas de acelerador, throughput, capacidade reservada ou outra unidade técnica auditável. Receita deve ser indicador complementar. Hardware, desempenho, disponibilidade, SLA e condições comerciais precisam ser comparáveis à capacidade exportada." },
  { number: "02", title: "Preservar um piso não substituível", body: "Revogar a troca integral da oferta doméstica por P&D. Se for necessário um compromisso, limitar a substituição à metade e preservar pelo menos 5% da capacidade efetiva total no Brasil." },
  { number: "03", title: "Incluir quem opera o compute", body: "Permitir a habilitação de empresas de GPU cloud, inferência e computação que usem data center de terceiro. Incluir refrigeração líquida, distribuição elétrica, controle térmico e interconexão de alta densidade." },
  { number: "04", title: "Criar uma porta brasileira de contratação", body: "Contar apenas capacidade com contrato executável no Brasil, documentação fiscal adequada, residência local dos dados, conformidade com LGPD e ANPD e suporte sujeito à legislação brasileira." },
  { number: "05", title: "Publicar resultados e recuperar benefícios", body: "Criar relatório anual, público e auditado. O descumprimento da oferta doméstica deve gerar clawback proporcional, sem prejuízo de prazo de correção, recurso e cancelamento em violações materiais ou reiteradas." },
] : [
  { number: "01", title: "Measure contractable capacity", body: "Measure the 10% through accelerator hours, throughput, reserved capacity, or another auditable technical unit. Revenue should be supplementary. Hardware, performance, availability, SLA, and commercial terms must be comparable with exported capacity." },
  { number: "02", title: "Preserve a non-substitutable floor", body: "Remove full substitution of domestic supply through R&D. If a compromise is needed, cap substitution at half and preserve at least 5% of total effective capacity in Brazil." },
  { number: "03", title: "Include compute operators", body: "Allow GPU cloud, inference, and compute companies using third-party data centers to qualify. Cover liquid cooling, power distribution, thermal control, and high-density interconnection." },
  { number: "04", title: "Create a Brazilian contracting door", body: "Count only capacity with a contract enforceable in Brazil, proper fiscal documentation, local data residency, LGPD and ANPD compliance, and support under Brazilian law." },
  { number: "05", title: "Publish results and recover benefits", body: "Create an annual, public, audited report. Breach of domestic-supply commitments should trigger proportional clawback, with cure and appeal rights and cancellation for material or repeated violations." },
];

const regulationPoints = pt ? [
  "Auditar capacidade instalada, oferecida, contratada e utilizada no Brasil.",
  "Divulgar geração do hardware, desempenho, SLA, disponibilidade e condições comerciais.",
  "Governar o P&D com chamadas abertas, beneficiários públicos e controle de conflitos.",
  "Publicar WUE, volume absoluto, origem da água e situação hídrica local.",
  "Certificar energia sem dupla contagem e com emissões verificáveis.",
  "Divulgar reforços de rede, custos, cronograma e quem paga.",
  "Exigir avaliação independente antes de qualquer renovação após cinco anos.",
] : [
  "Audit capacity installed, offered, contracted, and used in Brazil.",
  "Disclose hardware generation, performance, SLA, availability, and commercial terms.",
  "Govern R&D through open calls, published beneficiaries, and conflict controls.",
  "Publish WUE, absolute volume, water source, and local water stress.",
  "Certify power without double counting and with verified emissions.",
  "Disclose grid reinforcements, costs, timeline, and who pays.",
  "Require independent review before any renewal after five years.",
];

const proposedLanguage = pt ? [
  { title: "Capacidade técnica", body: "Trocar a aferição por receita no art. 11-B, § 4º, por unidades técnicas auditáveis. Acrescentar equivalência de geração tecnológica, desempenho, disponibilidade, segurança, SLA e condições comerciais." },
  { title: "Piso doméstico", body: "Revogar o art. 11-B, § 6º. Como compromisso, permitir substituir no máximo metade da obrigação, preservando pelo menos 5% da oferta efetiva total no mercado interno." },
  { title: "Operador em instalação de terceiro", body: "Acrescentar ao art. 11-A a habilitação da pessoa jurídica que possua ou opere equipamentos de GPU cloud, HPC, treinamento ou inferência instalados em data center de terceiro." },
  { title: "Porta brasileira", body: "Acrescentar ao art. 11-B que só conta capacidade contratável no Brasil, com documentação fiscal, residência local, LGPD e ANPD, suporte sob lei brasileira e condições objetivas." },
  { title: "Relatório e clawback", body: "Incluir a oferta doméstica nas condições dos arts. 11-C e 11-D, ampliar o relatório anual e recuperar o benefício proporcionalmente ao déficit de cumprimento." },
] : [
  { title: "Technical capacity", body: "Replace the revenue test in Article 11-B(4) with auditable technical units. Add equivalence requirements for hardware generation, performance, availability, security, SLA, and commercial terms." },
  { title: "Domestic floor", body: "Repeal Article 11-B(6). As a compromise, cap substitution at half of the obligation while preserving at least 5% of total effective supply for the domestic market." },
  { title: "Operator in a third-party facility", body: "Add to Article 11-A the qualification of a legal entity that owns or operates GPU cloud, HPC, training, or inference equipment installed in a third-party data center." },
  { title: "Brazilian contracting door", body: "Add to Article 11-B that only capacity contractable in Brazil counts, with fiscal documentation, local residency, LGPD and ANPD compliance, Brazilian-law support, and objective terms." },
  { title: "Report and clawback", body: "Include domestic supply among the conditions in Articles 11-C and 11-D, expand the annual report, and recover benefits in proportion to the compliance shortfall." },
];

const amendmentMeta = [
  ["1", "Laércio Oliveira", "10163022", "energy-preference", "oppose"],
  ["2", "Eduardo Braga", "10163042", "national-capacity", "adjust"],
  ["3", "Nelsinho Trad", "10163049", "generation-concessions", "separate"],
  ["4", "Laércio Oliveira", "10163074", "energy-definition", "adjust"],
  ["5", "Laércio Oliveira", "10163128", "energy-definition-duplicate", "merge"],
  ["6", "Omar Aziz", "10163179", "national-capacity-duplicate", "adjust"],
  ["7", "Esperidião Amin", "10164009", "regional-reduction", "oppose"],
  ["8", "Jorge Seif", "10165596", "water-reuse", "adjust"],
  ["9", "Luis Carlos Heinze", "10165739", "coal-cde", "separate"],
  ["10", "Luis Carlos Heinze", "10165750", "curtailment-cost", "separate"],
  ["11", "Zequinha Marinho", "10171408", "local-generation", "adjust"],
  ["12", "Wellington Fagundes", "10172268", "storage-cost", "review"],
  ["13", "Izalci Lucas", "10172449", "local-content", "oppose"],
  ["14", "Irajá", "10172879", "storage-financing", "separate"],
  ["15", "Marcelo Castro", "10173923", "zpe-services", "separate"],
  ["16", "Esperidião Amin", "10181424", "gas-energy", "oppose"],
  ["17", "Luis Carlos Heinze", "10181886", "network-credit", "adjust"],
  ["18", "Luis Carlos Heinze", "10181890", "hydro-renewal", "separate"],
  ["19", "Luis Carlos Heinze", "10181894", "storage-cost-duplicate", "merge"],
  ["20", "Jayme Campos", "10204658", "zpe-domestic-services", "adjust"],
  ["21", "Veneziano Vital do Rêgo", "10215127", "energy-certification", "support"],
  ["22", "Laércio Oliveira", "10281299", "energy-source-list", "oppose"],
] as const;

const labels = {
  pt: {
    "energy-preference": ["Torna o uso de energia limpa apenas preferencial", "A emenda foi retirada pelo autor. Se o conteúdo voltar ao texto, ele enfraquece uma contrapartida central e deve ser rejeitado.", "Retirada; rejeitar se voltar"],
    "national-capacity": ["Troca similar nacional por capacidade produtiva equivalente", "A redação pode melhorar o texto-base, mas mantém uma trava à importação dependente de ato do Executivo. Só é aceitável como fallback com critérios objetivos de geração, desempenho, volume, prazo, confiabilidade e custo; decisão rápida; silêncio positivo; lista pública e recurso.", "Aceitar só como fallback"],
    "generation-concessions": ["Altera regras de concessões de geração", "A mudança amplia o escopo do projeto e não melhora a capacidade contratável, a fiscalização ou o benefício público do REDATA.", "Tratar separadamente"],
    "energy-definition": ["Define energia limpa por impacto ou emissões", "O conceito pode ajudar, desde que o regulamento use emissões verificadas e impeça dupla contagem. A emenda não cria esses controles.", "Apoiar com ajustes"],
    "energy-definition-duplicate": ["Repete a definição proposta na Emenda 4", "Duas definições paralelas aumentam a ambiguidade. O Senado deve consolidar o tema em um único dispositivo com padrão mensurável.", "Fundir com a 4"],
    "national-capacity-duplicate": ["Repete o teste de capacidade da Emenda 2", "Mantém a mesma trava à importação dependente de ato do Executivo. Se a solução for usada, deve ser consolidada com critérios técnicos objetivos, prazo curto, silêncio positivo, lista pública e recurso.", "Mesmo fallback da 2"],
    "regional-reduction": ["Reduz contrapartidas em regiões carboníferas do Sul", "A localização não deve reduzir a parcela de capacidade acessível ao Brasil. A nova exceção pode se somar a outras reduções e esvaziar a contrapartida.", "Rejeitar"],
    "water-reuse": ["Considera o WUE cumprido com água de reuso externa", "O reuso merece incentivo, mas não dispensa volume absoluto, origem da água ou situação hídrica local. A regra proposta cria um atalho de medição.", "Reescrever"],
    "coal-cde": ["Muda a tributação de reembolsos da CDE para carvão", "A proposta altera a política para carvão sem relação direta com as cinco garantias do REDATA e sem uma análise de incidência dentro deste projeto.", "Tratar separadamente"],
    "curtailment-cost": ["Redistribui custos de cortes de geração", "A emenda mexe na alocação de custos do sistema elétrico. O Senado deve avaliar quem paga e tratar o tema fora do pacote de data centers.", "Tratar separadamente"],
    "local-generation": ["Permite conexão direta entre geração e consumo", "A conexão pode reduzir gargalos, mas precisa preservar confiabilidade, planejamento da rede e transparência sobre custos que recaiam sobre outros consumidores.", "Apoiar com salvaguardas"],
    "storage-cost": ["Muda a alocação de custos de armazenamento", "Armazenamento pode apoiar cargas intensivas, mas a emenda pode transferir custos ao conjunto dos consumidores. Falta uma análise pública de incidência e adicionalidade.", "Exigir análise"],
    "local-content": ["Cria índice de conteúdo local", "A regra retoma a lógica de reserva de mercado antes de existir oferta nacional de fronteira. Pode atrasar importações, estimular captura e repetir problemas comerciais do Inovar-Auto sem criar aceleradores competitivos no país.", "Rejeitar"],
    "storage-financing": ["Torna baterias elegíveis a financiamento incentivado", "O armazenamento pode melhorar a confiabilidade, mas a emenda cria um benefício fiscal próprio. Ela precisa demonstrar adicionalidade, custo e regras de recuperação.", "Projeto próprio ou ajuste"],
    "zpe-services": ["Altera contratos de serviços em ZPE", "O tema afeta a cadeia de serviços, mas promove uma reforma ampla do regime de ZPE sem criar a porta brasileira de contratação exigida no REDATA.", "Tratar no marco de ZPE"],
    "gas-energy": ["Classifica gás natural e biometano como energia limpa", "As emissões variam por combustível e operação. O texto deve usar intensidade de carbono verificada, em vez de conceder aprovação automática por categoria.", "Rejeitar como está"],
    "network-credit": ["Cria crédito para redes submarinas e terrestres", "Interconexão faz parte da infraestrutura necessária, mas um crédito novo exige custo fiscal público, acesso não discriminatório, adicionalidade e clawback.", "Reescrever"],
    "hydro-renewal": ["Altera renovação de concessões hidrelétricas", "A emenda trata de uma política ampla de concessões e não melhora as contrapartidas do REDATA. A análise exige um processo próprio.", "Tratar separadamente"],
    "storage-cost-duplicate": ["Repete a mudança de custos da Emenda 12", "A duplicação deve ser eliminada. Qualquer redação consolidada precisa mostrar quem paga e como a mudança afeta tarifas e concorrência.", "Fundir com a 12"],
    "zpe-domestic-services": ["Amplia serviços e vendas domésticas em ZPE", "O conceito pode facilitar contratação local, mas a reforma não garante LGPD, processamento local, contrato brasileiro ou equivalência da capacidade oferecida.", "Aproveitar o conceito"],
    "energy-certification": ["Cria sistema nacional unificado de certificados", "É a base mais útil entre as emendas ambientais. Deve exigir cancelamento do certificado usado, rastreabilidade e emissões verificadas.", "Apoiar com ajustes"],
    "energy-source-list": ["Lista gás entre fontes limpas ou de baixo carbono", "Uma lista por tecnologia não mede emissões reais e pode premiar instalações de alto carbono. O texto deve adotar um padrão de desempenho verificável.", "Rejeitar e substituir"],
  },
  en: {
    "energy-preference": ["Makes clean power a preference", "The author withdrew the amendment. If its content returns, it would weaken a core commitment and should be opposed.", "Withdrawn; oppose if revived"],
    "national-capacity": ["Replaces domestic similarity with equivalent productive capacity", "The wording may improve the base bill but keeps an import gate dependent on executive action. It is acceptable only as a fallback with objective tests for generation, performance, volume, delivery time, reliability, and cost; a short deadline; approval by silence; a public list; and appeal.", "Fallback only"],
    "generation-concessions": ["Changes generation-concession rules", "The change broadens the bill without improving contractable capacity, oversight, or REDATA's public benefit.", "Handle separately"],
    "energy-definition": ["Defines clean power by impact or emissions", "The concept can help if regulation uses verified emissions and prevents double counting. The amendment does not create those controls.", "Support with changes"],
    "energy-definition-duplicate": ["Repeats Amendment 4's definition", "Parallel definitions increase ambiguity. The Senate should consolidate the issue into one measurable standard.", "Merge with 4"],
    "national-capacity-duplicate": ["Repeats Amendment 2's capacity test", "It keeps the same import gate dependent on executive action. If used, the solution should be consolidated with objective technical criteria, a short deadline, approval by silence, a public list, and appeal.", "Same fallback as 2"],
    "regional-reduction": ["Reduces commitments in southern coal regions", "Location should not reduce capacity available to Brazil. This exception may combine with other reductions and hollow out the commitment.", "Oppose"],
    "water-reuse": ["Deems WUE satisfied through external reclaimed water", "Reuse should be encouraged, but it cannot waive absolute volume, water source, or local scarcity data. The amendment creates a measurement shortcut.", "Rewrite"],
    "coal-cde": ["Changes taxation of coal-related CDE reimbursements", "The proposal changes coal policy without a direct link to REDATA's five safeguards or an incidence analysis within this bill.", "Handle separately"],
    "curtailment-cost": ["Redistributes generation-curtailment costs", "The amendment changes power-system cost allocation. The Senate should identify who pays and consider it outside the data-center package.", "Handle separately"],
    "local-generation": ["Allows direct links between generation and consumption", "Direct connection may reduce bottlenecks, but it must preserve reliability, grid planning, and transparency over costs borne by other consumers.", "Add safeguards"],
    "storage-cost": ["Changes storage-cost allocation", "Storage may support intensive loads, but the amendment may shift costs to other consumers. It lacks a public incidence and additionality analysis.", "Require analysis"],
    "local-content": ["Creates a local-content index", "The rule revives reserve-market logic before a domestic frontier supply exists. It may delay imports, encourage capture, and repeat Inovar-Auto's trade problems without creating competitive accelerators in Brazil.", "Oppose"],
    "storage-financing": ["Makes batteries eligible for incentivized financing", "Storage may improve reliability, but the amendment creates a separate tax benefit. It needs evidence of additionality, cost, and recovery rules.", "Separate bill or revise"],
    "zpe-services": ["Changes ZPE service contracts", "The issue affects the service chain, but it creates a broad ZPE reform without establishing REDATA's Brazilian contracting door.", "Handle under ZPE law"],
    "gas-energy": ["Classifies natural gas and biomethane as clean power", "Emissions vary by fuel and operation. The bill should use verified carbon intensity instead of automatic approval by category.", "Oppose current text"],
    "network-credit": ["Creates a credit for submarine and terrestrial networks", "Interconnection is necessary infrastructure, but a new credit needs a published fiscal cost, open access, additionality, and clawback.", "Rewrite"],
    "hydro-renewal": ["Changes hydro-concession renewals", "The amendment addresses a broad concession policy and does not improve REDATA commitments. It requires a separate process.", "Handle separately"],
    "storage-cost-duplicate": ["Repeats Amendment 12's cost change", "The duplicate should be removed. Any consolidated language must show who pays and how the change affects tariffs and competition.", "Merge with 12"],
    "zpe-domestic-services": ["Expands domestic ZPE services and sales", "The concept may enable local contracts, but the reform does not guarantee LGPD compliance, local processing, a Brazilian contract, or equivalent capacity.", "Use the concept"],
    "energy-certification": ["Creates a unified national certificate system", "This is the most useful environmental amendment. It should require certificate retirement, traceability, and verified emissions.", "Support with changes"],
    "energy-source-list": ["Lists gas among clean or low-carbon sources", "A technology list does not measure real emissions and may reward high-carbon facilities. The bill should use a verified performance standard.", "Replace"],
  },
} as const;

const amendments = amendmentMeta.map(([number, author, dm, key, stance]) => {
  const [subject, relation, recommendation] = labels[pt ? "pt" : "en"][key];
  return { number, author, subject, relation, recommendation, stance, url: `https://legis.senado.leg.br/sdleg-getter/documento?dm=${dm}&disposition=inline` };
});

const sources = pt ? [
  ["Tramitação e 22 emendas", "Senado Federal", "https://www25.senado.leg.br/web/atividade/materias/-/materia/172786"],
  ["Possível votação na semana de 31 de agosto", "Agência Senado", "https://www12.senado.leg.br/noticias/materias/2026/08/27/senado-pode-votar-na-proxima-semana-incentivos-fiscais-para-data-centers"],
  ["Texto aprovado e contrapartidas", "Agência Câmara", "https://www.camara.leg.br/noticias/1247282-camara-aprova-incentivo-fiscal-para-investimentos-em-centros-de-processamento-de-dados/"],
  ["Texto-base e dispositivos", "Senado Federal", "https://legis.senado.leg.br/sdleg-getter/documento?dm=10162783&disposition=inline"],
  ["Precedente de conteúdo local no Inovar-Auto", "OMC, caso DS472", "https://www.wto.org/english/tratop_e/dispu_e/cases_e/ds472_e.htm"],
] : [
  ["Legislative status and 22 amendments", "Brazilian Senate", "https://www25.senado.leg.br/web/atividade/materias/-/materia/172786"],
  ["Possible vote during the August 31 session week", "Senate News", "https://www12.senado.leg.br/noticias/materias/2026/08/27/senado-pode-votar-na-proxima-semana-incentivos-fiscais-para-data-centers"],
  ["Chamber text and commitments", "Chamber News", "https://www.camara.leg.br/noticias/1247282-camara-aprova-incentivo-fiscal-para-investimentos-em-centros-de-processamento-de-dados/"],
  ["Base bill and provisions", "Brazilian Senate", "https://legis.senado.leg.br/sdleg-getter/documento?dm=10162783&disposition=inline"],
  ["Local-content precedent in Inovar-Auto", "WTO, dispute DS472", "https://www.wto.org/english/tratop_e/dispu_e/cases_e/ds472_e.htm"],
];
---

<BaseLayout locale={locale} pageKey="redata" markdownHref={markdownRoutes[locale].redata} title="REDATA" description={pt ? "Recomendações ao Senado para transformar incentivos a data centers em capacidade contratável e uma indústria brasileira de inferência." : "Recommendations to turn data-center incentives into contractable capacity and a Brazilian inference industry."}>
  <PageHero compact locale={locale} eyebrow={pt ? "PL 278/2026 · Nota aos senadores" : "Bill 278/2026 · Note to senators"} title={pt ? "Aprovar o REDATA com cinco ajustes" : "Pass REDATA with five changes"} intro={pt ? "O projeto reduz um obstáculo real ao investimento. O Senado pode garantir que os benefícios também criem capacidade disponível para empresas, universidades e serviços públicos brasileiros." : "The bill removes a real barrier to investment. The Senate can ensure that its benefits also create capacity available to Brazilian companies, universities, and public services."} />

  <div class="page-content redata-content">
    <section class="redata-live" aria-labelledby="redata-live-title">
      <div><span>{pt ? "Situação em 28 ago 2026" : "Status on 28 Aug 2026"}</span><h2 id="redata-live-title">{pt ? "Falta um bloco novo de emendas" : "A new amendment package is still needed"}</h2></div>
      <p>{pt ? "O PL 278/2026 está no Plenário do Senado, ainda sem relator. Foram apresentadas 22 emendas; a Emenda 1 consta como retirada. Nenhuma das restantes cobre integralmente os cinco ajustes necessários para transformar o incentivo em capacidade contratável no Brasil." : "Bill 278/2026 is before the Senate plenary and still has no rapporteur. Senators filed 22 amendments; Amendment 1 is listed as withdrawn. None of the remaining amendments fully covers the five changes needed to turn the incentive into capacity that can be contracted in Brazil."}</p>
      <div class="redata-live-actions">
        <a class="button-link" href="https://www25.senado.leg.br/web/atividade/materias/-/materia/172786">{pt ? "Acompanhar no Senado" : "Follow in the Senate"}</a>
        <a class="button-link primary" href={routes[locale].support}>{pt ? "Apoie esse pedido" : "Support this request"}</a>
        <a href={routes[locale].signatories}>{pt ? "Ver signatários" : "View signatories"}</a>
      </div>
    </section>

    <section class="redata-executive-summary" aria-labelledby="executive-summary-title">
      <div>
        <span>{pt ? "Nota executiva · uma página" : "Executive note · one page"}</span>
        <h2 id="executive-summary-title">{pt ? "Aprovar o REDATA e exigir capacidade útil ao Brasil" : "Pass REDATA and require useful capacity for Brazil"}</h2>
      </div>
      <div>
        <p>{pt ? "O incentivo reduz o custo de instalar computação, mas o texto atual não garante quantidade, qualidade ou contratação local. A medição por receita e a substituição integral por P&D permitem que um projeto receba o benefício sem reservar capacidade moderna aos usuários brasileiros." : "The incentive lowers the cost of installing computing infrastructure, but the current bill does not guarantee quantity, quality, or domestic contracting. Revenue-based measurement and full R&D substitution allow a project to receive the benefit without reserving modern capacity for Brazilian users."}</p>
        <p>{pt ? "O Senado deve medir capacidade técnica, preservar um piso doméstico, incluir operadores e equipamentos de alta densidade, criar uma porta brasileira de contratação e aplicar relatório com clawback." : "The Senate should measure technical capacity, preserve a domestic floor, include operators and high-density equipment, create a Brazilian contracting door, and require reporting with clawback."}</p>
        <a class="button-link" href={routes[locale].redataNote}>{pt ? "Abrir a nota para imprimir" : "Open the printable note"}</a>
      </div>
    </section>

    <section aria-labelledby="numbers-title">
      <h2 id="numbers-title">{pt ? "O texto que chegou ao Senado" : "The text before the Senate"}</h2>
      <div class="redata-metrics">{metrics.map(([value, label, detail]) => <article><strong>{value}</strong><span>{label}</span><p>{detail}</p></article>)}</div>
      <div class="callout">{pt ? "Nossa posição: aprovar com mudanças pontuais. Sem elas, o Brasil pode subsidiar máquinas modernas sem garantir que empresas brasileiras consigam contratá-las." : "Our position: pass the bill with targeted changes. Without them, Brazil may subsidize modern machines without ensuring that Brazilian companies can contract them."}</div>
    </section>

    <section aria-labelledby="value-title">
      <h2 id="value-title">{pt ? "O prédio é só a primeira camada" : "The building is only the first layer"}</h2>
      <p class="section-lead">{pt ? "O Brasil captura mais valor quando empresas disputam as camadas acima da infraestrutura física." : "Brazil captures more value when companies compete across the layers above physical infrastructure."}</p>
      <figure class="compute-value-chain" aria-label={pt ? "Cadeia de valor da infraestrutura física às aplicações" : "Value chain from physical infrastructure to applications"}>
        <div><span>01</span><strong>{pt ? "Data center" : "Data center"}</strong><small>{pt ? "energia, espaço e refrigeração" : "power, space, and cooling"}</small></div>
        <div><span>02</span><strong>{pt ? "Nuvem de GPUs" : "GPU cloud"}</strong><small>{pt ? "aceleradores e interconexão" : "accelerators and interconnection"}</small></div>
        <div><span>03</span><strong>{pt ? "Inferência" : "Inference"}</strong><small>{pt ? "modelos, disponibilidade e segurança" : "models, availability, and security"}</small></div>
        <div><span>04</span><strong>{pt ? "Aplicações" : "Applications"}</strong><small>{pt ? "produtos, dados e distribuição" : "products, data, and distribution"}</small></div>
      </figure>
      <p>{pt ? "O REDATA já reduz custos de equipamentos e cria obrigações ambientais e tecnológicas. As mudanças abaixo fazem o incentivo apoiar também operadores de computação, provedores de inferência e compradores brasileiros." : "REDATA already lowers equipment costs and creates environmental and technology commitments. The changes below would also support compute operators, inference providers, and Brazilian buyers."}</p>
    </section>

    <section aria-labelledby="changes-title">
      <h2 id="changes-title">{pt ? "Cinco ajustes ao projeto" : "Five changes to the bill"}</h2>
      <div class="redata-changes">{changes.map((item) => <article><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div>
    </section>

    <section class="redata-companions" aria-labelledby="red-lines-title">
      <h2 id="red-lines-title">{pt ? "Duas linhas vermelhas" : "Two red lines"}</h2>
      <div class="principle-grid">
        <article class="principle-card"><span class="card-index">A</span><h3>{pt ? "Não bloquear o hardware que o Brasil ainda não produz" : "Do not block hardware Brazil does not yet make"}</h3><p>{pt ? "Rejeitar índice rígido de conteúdo local e trava de importação sem saída objetiva. A regra preferida libera equipamentos estratégicos de fronteira; o fallback exige equivalência técnica completa, decisão rápida, silêncio positivo, lista pública e recurso." : "Reject rigid local-content targets and import gates without an objective exit. The preferred rule exempts strategic frontier equipment; the fallback requires full technical equivalence, a short deadline, approval by silence, a public list, and appeal."}</p></article>
        <article class="principle-card"><span class="card-index">B</span><h3>{pt ? "Não chamar gás natural de energia limpa" : "Do not call natural gas clean power"}</h3><p>{pt ? "Gás pode servir como contingência, com horas de uso, emissões e plano de transição publicados. Ele não deve cumprir automaticamente a obrigação de energia limpa nem receber o mesmo tratamento de fontes de baixa emissão verificável." : "Gas may provide emergency backup if operating hours, emissions, and a transition plan are disclosed. It should not automatically satisfy the clean-power obligation or receive the same treatment as sources with verifiably low emissions."}</p></article>
      </div>
    </section>

    <section aria-labelledby="amendment-review-title">
      <div class="redata-section-heading">
        <div>
          <span>{pt ? "Revisão das 22 emendas apresentadas" : "Review of all 22 filed amendments"}</span>
          <h2 id="amendment-review-title">{pt ? "A pauta atual ainda não resolve o problema" : "The current amendment agenda does not solve the problem"}</h2>
        </div>
        <p>{pt ? "A leitura foi feita contra os cinco pedidos e os sete pontos de regulamentação. A Emenda 21 é a única que cobre parcialmente um ponto regulatório. O texto atual da Emenda 8 enfraquece a medição da água." : "We assessed each amendment against the five requests and seven regulatory points. Amendment 21 is the only one to partially cover a regulatory point. Amendment 8's current text weakens water-use measurement."}</p>
      </div>

      <div class="coverage-strip" aria-label={pt ? "Cobertura das emendas atuais" : "Coverage of current amendments"}>
        <article><strong>0/5</strong><span>{pt ? "pedidos cobertos integralmente" : "requests fully covered"}</span></article>
        <article><strong>1/7</strong><span>{pt ? "pontos regulatórios cobertos parcialmente" : "regulatory points partly covered"}</span></article>
        <article><strong>1</strong><span>{pt ? "emenda útil como ponto de partida parcial: 21" : "useful partial starting point: 21"}</span></article>
      </div>

      <div class="amendment-table-wrap" tabindex="0" aria-label={pt ? "Tabela rolável das 22 emendas" : "Scrollable table of all 22 amendments"}>
        <table class="amendment-table">
          <thead><tr><th>{pt ? "Emenda" : "Amendment"}</th><th>{pt ? "Autor" : "Author"}</th><th>{pt ? "Conteúdo" : "Subject"}</th><th>{pt ? "Comentário" : "Comment"}</th><th>{pt ? "Posição" : "Position"}</th></tr></thead>
          <tbody>
            {amendments.map((item) => <tr>
              <td><a href={item.url}>#{item.number}</a></td>
              <td>{item.author}</td>
              <td>{item.subject}</td>
              <td>{item.relation}</td>
              <td><span class:list={["amendment-stance", `stance-${item.stance}`]}>{item.recommendation}</span></td>
            </tr>)}
          </tbody>
        </table>
      </div>
      <p class="table-note">{pt ? "No celular, deslize a tabela horizontalmente. Abra o número da emenda para ler o PDF oficial no Senado." : "On mobile, scroll the table horizontally. Open an amendment number to read the official Senate PDF."}</p>
    </section>

    <section aria-labelledby="regulation-title">
      <div class="redata-section-heading compact-heading">
        <div><span>{pt ? "Regulamentação" : "Regulation"}</span><h2 id="regulation-title">{pt ? "Sete obrigações que não podem ficar implícitas" : "Seven duties that cannot remain implicit"}</h2></div>
        <p>{pt ? "O texto deve delegar estes pontos com clareza e exigir dados comparáveis por instalação." : "The bill should delegate these points clearly and require comparable facility-level data."}</p>
      </div>
      <ol class="regulation-list">{regulationPoints.map((point, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{point}</p></li>)}</ol>
    </section>

    <section aria-labelledby="language-title">
      <h2 id="language-title">{pt ? "Redação proposta para a negociação" : "Proposed language for negotiations"}</h2>
      <p class="section-lead">{pt ? "Os dispositivos abaixo traduzem os cinco pedidos em comandos legislativos. A consultoria legislativa deve consolidar remissões, competência e impacto fiscal antes do protocolo." : "The provisions below translate the five requests into legislative commands. Legislative counsel should consolidate cross-references, authority, and fiscal impact before filing."}</p>
      <div class="proposed-language-grid">{proposedLanguage.map((item, index) => <details><summary><span>{String(index + 1).padStart(2, "0")}</span>{item.title}</summary><p>{item.body}</p></details>)}</div>
    </section>

    <section class="redata-companions" aria-labelledby="companions-title">
      <h2 id="companions-title">{pt ? "Duas medidas fora do texto tributário" : "Two measures beyond the tax bill"}</h2>
      <div class="principle-grid">
        <article class="principle-card"><span class="card-index">A</span><h3>{pt ? "Licenciamento rápido com capacidade pública" : "Fast licensing with public capacity"}</h3><p>{pt ? "Padronizar termos de referência, analisar etapas em paralelo e financiar equipes ambientais. Prazo previsível exige medição de água, energia, rede e impactos territoriais; licença automática transfere o risco para a população." : "Standardize terms of reference, review stages in parallel, and fund environmental teams. Predictable timelines require measurement of water, power, grid, and territorial effects; automatic approval transfers risk to the public."}</p></article>
        <article class="principle-card"><span class="card-index">B</span><h3>{pt ? "Consórcio aberto de demanda" : "Open demand consortium"}</h3><p>{pt ? "Agregar compromissos futuros de bancos, varejo, energia, universidades e governo para negociar equipamentos e contratos. Adesão aberta, leilões, separação de dados e supervisão do Cade evitam captura e colusão." : "Aggregate future commitments from banks, retail, energy, universities, and government to negotiate equipment and contracts. Open participation, auctions, data separation, and competition oversight reduce capture and collusion."}</p></article>
      </div>
    </section>

    <section class="redata-message" aria-labelledby="message-title">
      <span>{pt ? "Mensagem de um minuto" : "One-minute message"}</span>
      <h2 id="message-title">{pt ? "O que pedir à liderança do Senado" : "What to ask Senate leaders"}</h2>
      <blockquote>{pt ? "O REDATA merece aprovação, mas as 22 emendas ainda deixam de fora os pontos que transformam incentivo fiscal em capacidade útil ao Brasil. Pedimos que os 10% sejam medidos por capacidade técnica contratável, que pelo menos 5% não possam ser trocados por P&D e que a obrigação doméstica tenha relatório e clawback proporcional. O texto também deve incluir operadores de GPU cloud em data centers de terceiros e criar uma porta brasileira de contratação, com contrato local, LGPD, residência de dados e suporte sob lei brasileira." : "REDATA deserves passage, but the 22 amendments still omit the safeguards that turn tax incentives into useful Brazilian capacity. Measure the 10% as contractable technical capacity, preserve at least 5% that cannot be replaced by R&D, and attach an annual report and proportional clawback to the domestic commitment. The bill should also include GPU cloud operators in third-party data centers and create a Brazilian contracting door with local contracts, LGPD compliance, data residency, and support under Brazilian law."}</blockquote>
    </section>

    <section aria-labelledby="sources-title">
      <h2 id="sources-title">{pt ? "Fontes primárias" : "Primary sources"}</h2>
      <div class="redata-sources">{sources.map(([title, source, url]) => <a href={url}><strong>{title}</strong><span>{source}</span></a>)}</div>
      <p class="evidence-boundary">{pt ? "Revisão factual: 28 de agosto de 2026. Leitura do texto-base e das 22 emendas oficiais. As recomendações representam a posição dos autores. Uma consultoria legislativa deve conferir remissões, iniciativa e impacto fiscal antes do protocolo." : "Factual review: August 28, 2026. Review of the base bill and all 22 official amendments. The recommendations represent the authors' position. Legislative counsel should review cross-references, authority, and fiscal impact before filing."}</p>
      <p><a class="button-link" href={routes[locale].scenario}>{pt ? "Ver como o REDATA muda os cenários" : "See how REDATA changes the scenarios"}</a></p>
    </section>
  </div>
</BaseLayout>
