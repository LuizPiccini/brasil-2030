---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { routes } from "../../data/site";
---
<BaseLayout
  locale="en"
  pageKey="signatories"
  title="Signatories"
  description="The list of signatories to the letter and its commitments opens after review."
>
  <PageHero
    compact
    locale="en"
    eyebrow="Public support"
    title="The list is not open yet"
    intro="The list of signatories to the letter will be published after editorial review. Nobody has signed yet."
  />
  <div class="page-content narrow-content">
    <h2>What will appear here</h2>
    <p>
      Name and type of endorsement, once verified. Candidacy commitments and institutional
      representations are checked before publication. Email addresses are never published.
    </p>
    <h2>In the meantime</h2>
    <p class="hero-actions">
      <a class="button-link primary" href={`${routes.en.letter}#assinar`}>Read the letter and its commitments</a>
      <a class="button-link" href={routes.en.strategy}>Read the strategy</a>
    </p>
  </div>
</BaseLayout>
