---
import BaseLayout from "../layouts/BaseLayout.astro";
import CandidateDashboard from "../components/CandidateDashboard.astro";
import CandidateContent, { getHeadings } from "../content/scenario-candidate-pt.md";
import candidateSource from "../content/scenario-candidate-pt.md?raw";
import { candidateIntroduction, candidateReadingTime } from "../data/candidate-reading-time";
import "../styles/candidate.css";

const headings = getHeadings().filter(({ depth }) => depth === 2);
const { minutes } = candidateReadingTime(candidateSource);
const chapters = headings.map((heading, index) => ({ ...heading,
  year: heading.text.match(/^20\d{2}/)?.[0] ?? ["Escolhas", "Apêndice", "Fontes"][index - 5],
  label: heading.text.replace(/^20\d{2}:\s*/, ""),
}));
---
<BaseLayout
  locale="pt"
  pageKey="scenario"
  candidate
  title="O custo do atraso na era da IA"
  description="Um cenário para o Brasil entre 2026 e 2030: a corrida da IA desacelera, mas o país chega ao acordo sem ter preparado suas alternativas."
  markdownHref="/cenario.md"
  bodyClass="scenario-page candidate-page"
>
  <div class="reading-layout">
    <section class="candidate-opening" aria-labelledby="candidate-title">
      <h1 id="candidate-title">Brasil 2030<span>O custo do atraso na era da IA</span></h1>
      {candidateIntroduction.map(paragraph => <p class="candidate-deck">{paragraph}</p>)}
      <p class="candidate-reading-time" title="Introdução e narrativa de 2026–2030, a 210 palavras por minuto. Não inclui resumo, quadros, notas, recomendações ou apêndice.">Cerca de {minutes} min de leitura</p>
      <p class="candidate-disclaimer">Este é um cenário, não uma previsão. As personagens são fictícias; os acontecimentos futuros exploram escolhas e consequências possíveis. As fontes do ponto de partida estão nas notas.</p>
    </section>
    <nav class="chapter-nav" data-candidate-nav aria-label="Linha do tempo">
      <span class="chapter-nav-label">Linha do tempo</span>
      <ol>
        {chapters.map(({ slug, text, year, label }, index) => <li><a href={`#${slug}`} class={index === 0 ? "is-active" : undefined} data-chapter-label={text} aria-current={index === 0 ? "location" : undefined}><span>{year}</span><span>{label}</span></a></li>)}
      </ol>
    </nav>
    <article class="scenario-prose candidate-prose" aria-label="O custo do atraso na era da IA: texto completo">
      <CandidateContent />
    </article>
    <CandidateDashboard />
  </div>
  <div class="mobile-chapter-bar" aria-live="polite">
    <a class="year-arrow" data-previous-year aria-label="Ano anterior" aria-disabled="true" tabindex="-1">←</a>
    <span class="mobile-chapter-copy"><span data-current-chapter>{headings[0].text}</span><small data-mobile-state>Projetos em preparação · Acesso a regulamentar</small></span>
    <a class="year-arrow" data-next-year href={`#${headings[1].slug}`} aria-label="Próximo ano: 2027">→</a>
  </div>
  <style>
    .mobile-chapter-bar { grid-template-columns:44px minmax(0,1fr) 44px; }
    .mobile-chapter-bar .year-arrow { display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; font-size:1.6rem; text-decoration:none; }
    .year-arrow[aria-disabled="true"] { opacity:.3; cursor:default; }
    .year-arrow:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
  </style>
  <script>
    import "../scripts/candidate-reader";
  </script>
</BaseLayout>
