---
// The fontsource entrypoints ship every subset: cyrillic, greek and vietnamese included.
// The site's content uses nothing outside the latin subset, so the two faces are declared
// here instead, which also lets them be preloaded. tests/font-subsets.test.mjs fails if
// content ever introduces a character these files cannot render.
import literataLatin from "@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url";
import plexLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";

const LATIN_RANGE = "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Glossary from "../components/Glossary.astro";
import { routes, siteCopy, type Locale, type PageKey } from "../data/site";
import { NOINDEX, PUBLICATION_OPEN } from "../data/publication.mjs";

interface Props {
  locale: Locale;
  pageKey: PageKey;
  title?: string;
  description?: string;
  markdownHref?: string;
  bodyClass?: string;
  candidate?: boolean;
}

const { locale, pageKey, markdownHref, bodyClass = "", candidate = false } = Astro.props;
const copy = siteCopy[locale];
const title = Astro.props.title ? `${Astro.props.title} | ${locale === "pt" ? "Brasil 2030" : "Brazil 2030"}` : copy.title;
const description = Astro.props.description ?? copy.description;
const canonical = new URL(candidate ? "/" : Astro.url.pathname, Astro.site);
const ptAlternate = new URL(routes.pt[pageKey], Astro.site);
const enAlternate = new URL(routes.en[pageKey], Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={copy.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="preload" as="font" type="font/woff2" href={literataLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={plexLatin} crossorigin="anonymous" />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Literata Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url(${literataLatin}) format('woff2-variations');
        unicode-range: ${LATIN_RANGE};
      }
      @font-face {
        font-family: 'IBM Plex Sans Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 700;
        src: url(${plexLatin}) format('woff2-variations');
        unicode-range: ${LATIN_RANGE};
      }
    `}></style>
    <meta name="description" content={description} />
    {!PUBLICATION_OPEN && <meta name="robots" content={NOINDEX} />}
    <link rel="canonical" href={canonical} />
    {!candidate && <>
      <link rel="alternate" hreflang="pt-BR" href={ptAlternate} />
      <link rel="alternate" hreflang="en" href={enAlternate} />
      <link rel="alternate" hreflang="x-default" href={ptAlternate} />
    </>}
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    <meta property="og:site_name" content={locale === "pt" ? "Brasil 2030" : "Brazil 2030"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === "pt" ? "Brasil 2030: O custo do atraso na era da IA" : "Brazil 2030: The Cost of Delay in the AI Era"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteHeader locale={locale} pageKey={pageKey} markdownHref={markdownHref} candidate={candidate} />
    <main id="main-content" tabindex="-1">
      {locale === "pt" && pageKey === "strategy" && <aside class="edition-notice" style="padding:1.5rem;border-bottom:1px solid currentColor"><strong>Arquivo histórico.</strong> Esta página preserva a edição anterior e não representa uma campanha em andamento. Os apoios ao REDATA não são assinaturas da nova carta. <a href="/carta-aberta">Leia a carta e os compromissos atuais</a>.</aside>}
      <slot />
    </main>
    <SiteFooter locale={locale} markdownHref={markdownHref} />
    {locale === "pt" && <Glossary />}
  </body>
</html>
