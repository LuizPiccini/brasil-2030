---
import "@fontsource-variable/literata";
import "@fontsource-variable/ibm-plex-sans";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { routes, siteCopy, type Locale, type PageKey } from "../data/site";

interface Props {
  locale: Locale;
  pageKey: PageKey;
  title?: string;
  description?: string;
  markdownHref?: string;
  bodyClass?: string;
}

const { locale, pageKey, markdownHref, bodyClass = "" } = Astro.props;
const copy = siteCopy[locale];
const title = Astro.props.title ? `${Astro.props.title} | ${locale === "pt" ? "Brasil 2030" : "Brazil 2030"}` : copy.title;
const description = Astro.props.description ?? copy.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ptAlternate = new URL(routes.pt[pageKey], Astro.site);
const enAlternate = new URL(routes.en[pageKey], Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={copy.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e6" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptAlternate} />
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="x-default" href={ptAlternate} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    <meta property="og:site_name" content={locale === "pt" ? "Brasil 2030" : "Brazil 2030"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1734" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content={locale === "pt" ? "Brasil 2030: Energia para Escolher" : "Brazil 2030: The Energy to Choose"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteHeader locale={locale} pageKey={pageKey} markdownHref={markdownHref} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} markdownHref={markdownHref} />
  </body>
</html>
